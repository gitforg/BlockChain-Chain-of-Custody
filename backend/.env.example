# Copy to .env and fill in your own values.

# --- Database ----------------------------------------------------------------
# The Prisma schema currently pins SQLite (prisma/schema.prisma), so this is
# only read by the Prisma CLI via prisma.config.ts.
DATABASE_URL="file:./dev.db"

# --- Server ------------------------------------------------------------------
PORT=5000

# --- Blockchain --------------------------------------------------------------
# Must match the frontend's NEXT_PUBLIC_RPC_URL / NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS.
RPC_URL="http://127.0.0.1:8545"
REGISTRY_CONTRACT_ADDRESS="0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"

# Server-side signer, used only for the disposal flow. This is Hardhat's
# well-known test account #0 — never use it on a public network.
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# --- Pinata IPFS -------------------------------------------------------------
# Leave PINATA_JWT empty to run offline: the service falls back to simulated CIDs.
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"
